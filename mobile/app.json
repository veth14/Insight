{
  "expo": {
    "name": "Insight",
    "slug": "insight-research",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.veth14.insight",
      "buildNumber": "1.0.1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.veth14.insight",
      "versionCode": 2,
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to allow you to upload research documents and system images.",
          "cameraPermission": "The app accesses your camera to allow you to take photos of your research documents."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a4d7fc4d-fd45-4d9b-b9f2-4ff5b9d605f8"
      }
    }
  }
}
